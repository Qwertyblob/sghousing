{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lease_decay.json",
  "description": "Price per sqm by whole years of remaining lease and flat type ('ALL' rollup).",
  "type": "object",
  "required": [
    "columns",
    "rows",
    "from",
    "to",
    "min_sales"
  ],
  "properties": {
    "columns": {
      "const": [
        "flat_type",
        "lease_years",
        "sales",
        "median_psm",
        "median_rel_psm"
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "minItems": 5,
        "maxItems": 5
      }
    },
    "from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "to": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "min_sales": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
