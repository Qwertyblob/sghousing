{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "meta.json",
  "description": "Coverage, refresh, model, towns and credits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coverage",
    "last_refresh",
    "priced_for",
    "model",
    "towns",
    "sources",
    "licence",
    "geocoder",
    "disclaimer"
  ],
  "properties": {
    "coverage": {
      "type": "object",
      "required": [
        "from",
        "to",
        "transactions"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "transactions": {
          "type": "integer"
        }
      }
    },
    "last_refresh": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
    },
    "priced_for": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "model": {
      "type": "object",
      "required": [
        "version",
        "trained_on",
        "data_window"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "trained_on": {
          "type": "string"
        },
        "data_window": {
          "type": "object"
        },
        "test": {
          "type": "object",
          "required": [
            "sales",
            "mae",
            "mape",
            "r2",
            "interval_80_coverage"
          ],
          "properties": {
            "sales": {
              "type": "integer"
            },
            "mae": {
              "type": "number"
            },
            "mape": {
              "type": "number"
            },
            "r2": {
              "type": "number"
            },
            "interval_80_coverage": {
              "type": "number"
            }
          }
        }
      }
    },
    "towns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "town",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "town": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "pattern": "^recent/[a-z0-9-]+\\.json$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "dataset_id",
          "name",
          "url",
          "last_updated",
          "retrieved"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "dataset_id": {
            "type": "string",
            "pattern": "^d_[0-9a-f]{32}$"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://data\\.gov\\.sg/"
          },
          "last_updated": {
            "type": [
              "string",
              "null"
            ]
          },
          "retrieved": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"
          }
        }
      }
    },
    "licence": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "geocoder": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "disclaimer": {
      "type": "string"
    }
  }
}
