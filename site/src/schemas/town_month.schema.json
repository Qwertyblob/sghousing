{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "town_month.json",
  "description": "Median price per sqm and sales by town, flat type and month ('ALL' rollups).",
  "type": "object",
  "required": [
    "columns",
    "rows",
    "from"
  ],
  "properties": {
    "columns": {
      "const": [
        "town",
        "flat_type",
        "month",
        "sales",
        "median_psm",
        "median_price"
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          },
          {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          },
          {
            "type": "integer",
            "minimum": 1
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "minItems": 6,
        "maxItems": 6
      }
    },
    "from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    }
  },
  "additionalProperties": false
}
