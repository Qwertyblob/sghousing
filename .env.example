DATABASE_URL=postgresql+psycopg://sg:sg@localhost:5432/sg_housing
DATAGOV_API_KEY=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
GEOCODE_REQUESTS_PER_SECOND=3
TRAIN_END=2023-12
VALID_END=2024-12

# Host port Docker Compose publishes Postgres on (bound to 127.0.0.1 only).
# Must match the port in DATABASE_URL; settings validation fails if they differ.
POSTGRES_PORT=5432
